# Copy to backend/.env and fill in what you have. Everything except Open-Meteo is optional.

AIRENV_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Default location before a profile is configured
DEFAULT_LOCATION_NAME=New Delhi
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
DEFAULT_TIMEZONE=Asia/Kolkata

REFRESH_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true

# Storage: auto | sqlite | firestore   (auto = Firestore when Firebase credentials are set)
STORAGE_BACKEND=auto
SQLITE_PATH=./data/airenv.db

# Firebase (Firestore + Authentication). FIREBASE_CREDENTIALS is a path to the service-account
# JSON file or the JSON content itself (useful on Render).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
# auto | local | firebase.  "local" = single local owner account, for development only.
AUTH_MODE=auto
# Comma-separated e-mails that receive the admin role on first sign-in
ADMIN_EMAILS=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Station data
OPENAQ_API_KEY=
# CPCB real-time AQI via https://data.gov.in (register for a free key)
DATA_GOV_IN_API_KEY=
SENSOR_COMMUNITY_ENABLED=true

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# webhook (production, needs PUBLIC_BASE_URL over HTTPS) | polling (local) | disabled
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

SNAPSHOT_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=12
# Reverse proxies in front of the API that append to X-Forwarded-For (Render: 1). 0 = ignore the header.
TRUSTED_PROXY_HOPS=0
# Largest accepted request body, in bytes
MAX_REQUEST_BYTES=262144
# Minimum seconds between forced provider refreshes of the same location
MANUAL_REFRESH_COOLDOWN_SECONDS=60
