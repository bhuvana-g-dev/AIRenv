# Backend base URL. Leave empty in development (Vite proxies /api to localhost:8000).
# Production example: https://airenv-api.onrender.com
VITE_API_BASE_URL=

# Optional Firebase Authentication (public web config, not secrets).
# Leave empty to use the backend's AUTH_MODE=local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
