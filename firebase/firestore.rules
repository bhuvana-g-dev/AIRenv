rules_version = '2';

// All writes go through the AIRenv backend (Firebase Admin SDK bypasses these rules).
// Clients may only read their own profile and notifications; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Raw group messages are never stored. Extracted events, groups, communities,
    // history, bundles and link codes are backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
